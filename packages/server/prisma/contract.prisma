// use prisma-8
model User {
  id            Int            @id @default(autoincrement())
  fullName      String
  bio           String?
  email         String         @unique
  username      String         @unique
  password      String
  image         String?
  coverImage    String?
  postsCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  notifications Notification[]
}

model Post {
  id              Int       @id @default(autoincrement())
  text            String
  image           String?
  commentsCount   Int       @default(0)
  likesCount      Int       @default(0)
  latestLike      String    @default("")
  createdAt       DateTime  @default(now())
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  latestCommentId Int?      @unique
  latestComment   Comment?  @relation("PostLatestComment", fields: [latestCommentId], references: [id], onDelete: SetNull)
  comments        Comment[] @relation("PostComments")
  likes           Like[]
}

model Comment {
  id              Int       @id @default(autoincrement())
  comment         String
  createdAt       DateTime  @default(now())
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId          Int
  post            Post      @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  latestCommentOf Post?     @relation("PostLatestComment")
}

model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  text      String
  postId    Int
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
